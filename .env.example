# LiteLLM Configuration
LITELLM_VERBOSE=True
DEFAULT_MODEL=azure/gpt-4

# OpenAI Configuration (optional)
# OPENAI_API_KEY=sk-your-openai-key

# Azure OpenAI Configuration
# These will be auto-populated by setup_azure_resources.sh
AZURE_API_KEY=your-azure-openai-key
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview

# Azure Foundry Configuration (same as Azure OpenAI for standard deployments)
AZURE_FOUNDRY_API_KEY=your-azure-openai-key
AZURE_FOUNDRY_API_BASE=https://your-resource.openai.azure.com/
AZURE_FOUNDRY_API_VERSION=2024-02-15-preview
AZURE_GPT4_DEPLOYMENT=gpt-4
AZURE_GPT5_DEPLOYMENT=gpt-35-turbo

# Anthropic Configuration (optional)
# ANTHROPIC_API_KEY=sk-ant-your-key

# Other providers (optional)
# HUGGINGFACE_API_KEY=hf_your-key
# COHERE_API_KEY=your-cohere-key